            "tags": {
              "Name": "devops-single-ec2"
            },
            "tags_all": {
              "Name": "devops-single-ec2"
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\nset -xe\n\nREPO_URL=\"\"\nBRANCH=\"main\"\n\napt-get update\napt-get install -y curl git apt-transport-https ca-certificates gnupg lsb-release\n\n# Install Docker\napt-get install -y docker.io\nsystemctl enable --now docker\n\n# Install docker-compose (v2)\nDOCKER_COMPOSE_BIN=/usr/local/bin/docker-compose\nif [ ! -f \"$DOCKER_COMPOSE_BIN\" ]; then\n  curl -SL \"https://github.com/docker/compose/releases/download/v2.20.2/docker-compose-$(uname -s)-$(uname -m)\" -o $DOCKER_COMPOSE_BIN\n  chmod +x $DOCKER_COMPOSE_BIN\nfi\n\n# Install Java and Jenkins\napt-get install -y openjdk-11-jdk\ncurl -fsSL https://pkg.jenkins.io/debian-stable/jenkins.io.key | tee /usr/share/keyrings/jenkins-keyring.asc \u003e/dev/null\necho 'deb [signed-by=/usr/share/keyrings/jenkins-keyring.asc] https://pkg.jenkins.io/debian-stable binary/' \u003e /etc/apt/sources.list.d/jenkins.list\napt-get update\napt-get install -y jenkins\n\n# Add jenkins user to docker group so pipelines can run docker\nusermod -aG docker jenkins || true\nusermod -aG docker ubuntu || true\n\nsystemctl enable --now jenkins || true\n\n# Clone app repository and run docker-compose\nAPP_DIR=/opt/app\nif [ ! -d \"$APP_DIR\" ]; then\n  git clone --branch \"$BRANCH\" \"$REPO_URL\" \"$APP_DIR\"\nelse\n  cd \"$APP_DIR\"\n  git fetch --all\n  git checkout \"$BRANCH\"\n  git pull origin \"$BRANCH\"\nfi\n\ncd \"$APP_DIR\"\n# If docker-compose.yml exists in project root, start it\nif [ -f docker-compose.yml ]; then\n  $DOCKER_COMPOSE_BIN down || true\n  $DOCKER_COMPOSE_BIN up -d --build\nfi\n\necho \"Bootstrap completed\"\necho \"Jenkins initial admin password:\"\ncat /var/lib/jenkins/secrets/initialAdminPassword || true\n",
            "user_data_base64": null,
            "user_data_replace_on_change": false,
            "volume_tags": null,
